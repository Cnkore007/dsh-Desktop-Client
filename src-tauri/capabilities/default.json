{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the local console page (main window).",
  "windows": ["main"],
  "permissions": [
    "allow-status",
    "allow-logs",
    "allow-clear-logs",
    "allow-start",
    "allow-restart",
    "allow-stop",
    "allow-info",
    "allow-open-browser",
    "allow-enter-ui",
    "allow-open-data-dir",
    "allow-autostart-enabled",
    "allow-set-port",
    "allow-autostart-set",
    "allow-update-dsh",
    "allow-set-locale",
    "allow-get-locale",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
